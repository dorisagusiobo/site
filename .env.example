# Copy to .env.local and fill in. Never commit real values.

# Required: powers the Digital Twin (https://openrouter.ai/keys).
# Give this key a credit limit in OpenRouter as a spending backstop.
OPENROUTER_API_KEY=

# Required in production: a long random string used to sign the Digital Twin's
# replies. Generate one with: openssl rand -hex 32
TWIN_SIGNING_SECRET=

# Optional: the public URL, for link previews and the sitemap.
# SITE_URL=https://example.com
